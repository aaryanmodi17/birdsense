# Large raw inputs and derived/processed files — not committed to git.
# See docs/11_CODE_STRUCTURE.md (data/raw and data/processed are not committed).
data/raw/
data/processed/

# Python virtual environment
.venv/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Generated figures/tables — reproducible by running notebook 06, and they
# currently embed MOCK environmental values (Fig 6 / Table 5). Keep the dirs.
outputs/figures/*
outputs/tables/*
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# Raw source archives (e.g. the eBird EBD zip) — large, not committed.
*.zip
